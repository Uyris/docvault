# ============================================================================
# DocVault — environment variables
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================================

# ---- LLM provider (Groq by default) ----------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me
# Generation model. See https://console.groq.com/docs/models
LLM_MODEL=llama-3.3-70b-versatile
# Cheaper/faster model used as the LLM judge during evaluation
LLM_EVAL_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---- Embeddings (local, runs on CPU — no API cost) --------------------------
# Any sentence-transformers model. Must match EMBEDDING_DIM below.
# all-MiniLM-L6-v2 -> 384 dims. For PT-BR docs try:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (also 384)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- Postgres + pgvector ----------------------------------------------------
POSTGRES_USER=docvault
POSTGRES_PASSWORD=docvault
POSTGRES_DB=docvault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async SQLAlchemy URL. In docker-compose, host is the service name `postgres`.
# DATABASE_URL=postgresql+asyncpg://docvault:docvault@localhost:5432/docvault

# ---- Redis (semantic cache + rate-limit storage) ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# ---- RAG tuning -------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
# Index type for pgvector: hnsw (better recall/latency) or ivfflat
VECTOR_INDEX_TYPE=hnsw

# ---- Semantic cache ---------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity >= this threshold counts as a cache hit (0..1)
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ENTRIES=1000

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Global default and a stricter limit for the expensive LLM endpoint
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_QUERY=20/minute

# ---- Cost accounting (USD per 1M tokens, for the dashboard) -----------------
# Defaults reflect Groq llama-3.3-70b pricing; adjust to your model.
COST_PER_1M_INPUT_TOKENS=0.59
COST_PER_1M_OUTPUT_TOKENS=0.79

# ---- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=20
UPLOAD_DIR=./uploads

# ---- App / CORS -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
